# Cấu hình Database
# Thay password bằng một chuỗi mạnh mẽ, phức tạp
SA_PASSWORD=YourStrongPassword123!
ConnectionStrings__DefaultConnection=Server=mssql;Database=BookSoul;User Id=sa;Password=;TrustServerCertificate=True;MultipleActiveResultSets=true

# Cấu hình JWT
# Lưu ý: Cần dài ít nhất 32 ký tự để đảm bảo bảo mật
JwtSettings__SecretKey=YourSuperSecretKeyForJwtMustBeVeryLong
JwtSettings__Issuer=BookConsoulAPI
JwtSettings__Audience=BookConsoulUsers
JwtSettings__ExpiryInMinutes=60

# Cấu hình PayOS
PayOS__ClientId=YOUR_PAYOS_CLIENT_ID
PayOS__ApiKey=YOUR_PAYOS_API_KEY
PayOS__ChecksumKey=YOUR_PAYOS_CHECKSUM_KEY

# Cấu hình Admin & Staff Password
Seed__AdminPassword=Admin123!
Seed__StaffPassword=Staff123!

# Cấu hình Email SMTP
Email__Smtp__Password=YOUR_GMAIL_APP_PASSWORD